                "api",
                "borrowings",
                "borrow",
                "{{book_id}}"
              ]
            },
            "description": "Borrow a book copy. Automatically sets due date and decreases available_copies by 1."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created or 409 Conflict\", function () {",
