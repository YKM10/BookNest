    {
      "name": "02 Books",
      "item": [
        {
          "name": "Create Book",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{librarian_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman API Engineering Handbook\",\n  \"author\": \"Postman Engineer\",\n  \"isbn\": \"978-0{{$timestamp}}\",\n  \"category\": \"Software Engineering\",\n  \"publisher\": \"Tech Press\",\n  \"publication_year\": 2024,\n  \"total_copies\": 5,\n  \"available_copies\": 5,\n  \"description\": \"Comprehensive handbook on REST API testing and design.\"\n}"
            },
