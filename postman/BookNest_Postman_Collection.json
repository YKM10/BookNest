{
  "info": {
    "_postman_id": "booknest-collection-phase10",
    "name": "BookNest Digital Library API",
    "description": "Complete Postman API Collection for BookNest Digital Library (FastAPI + SQLAlchemy + JWT). Contains authentication, books CRUD, search/filtering, borrowing/returns, RBAC, and error validation tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Authentication",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Student\",\n  \"email\": \"postman_student_{{$timestamp}}@example.com\",\n  \"password\": \"student123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Register a new user account. Role is strictly assigned as STUDENT by the backend."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"User has default STUDENT role\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.role).to.eql(\"STUDENT\");",
                  "    pm.expect(jsonData).to.have.property(\"id\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Login Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
