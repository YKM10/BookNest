            },
            "description": "Create a new catalog title (Librarian/Admin only)."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set(\"temp_book_id\", jsonData.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "header": [
              {
